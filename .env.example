# Discord bot token (used by src/index.js, src/highbid-websocket.js and src/register-commands.js)
TOKEN=your-discord-bot-token

# Discord application ID and the guild where /status is registered (src/register-commands.js)
CLIENT_ID=your-discord-application-id
GUILD_ID=your-discord-guild-id

# Display name and version shown by the /status command
BOT=Radiants Bid Tracker
VERSION=1.0.0

# Helius API key for the websocket (transactionSubscribe) and RPC endpoints
HELIUS_API_KEY=your-helius-api-key

# Only read by the inactive src/create-auction-websocket.js module
CHANNEL_ID=your-discord-channel-id
